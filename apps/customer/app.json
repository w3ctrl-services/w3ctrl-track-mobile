{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12100d",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.w3ctrl.track"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.w3ctrl.track",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "W3ctrl Track shows your devices on a live map."
      },
      "supportsTablet": true
    },
    "name": "W3ctrl Track",
    "orientation": "portrait",
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff9900"
        }
      ]
    ],
    "scheme": "w3ctrl-track",
    "slug": "w3ctrl-track",
    "splash": {
      "backgroundColor": "#12100d",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "automatic",
    "version": "1.0.0"
  }
}
